# Copy to .env before docker compose deployment. Never commit real secrets.
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.2
GLM_REQUIRED_AT_STARTUP=true

MYSQL_PASSWORD=replace_with_a_strong_password
MYSQL_ROOT_PASSWORD=replace_with_another_strong_password

FRONTEND_PORT=8080
INSTALL_ML=true
MINERU_BIN=mineru
