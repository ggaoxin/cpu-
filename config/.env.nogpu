# ====================================================================
# 无 GPU 版配置模板（CPU only，不依赖 vllm/cuda）
# 用法：cp config/.env.nogpu config/.env   （覆盖原 GPU 版 .env）
#
# 关键差异（vs GPU 版 .env）：
#   - BGE_DEVICE=cpu        bge 向量模型走 CPU（慢但能跑，自动检测也可，显式更稳）
#   - MINERU_BACKEND=pipeline  mineru 走 onnxruntime CPU pipeline（不用 vllm/VLM）
#   - MINERU_MAX_CONCURRENCY=3  CPU 并发调低（onnxruntime 单请求占满核，8 会饱和排队）
#   - MINERU_API_TIMEOUT=900    CPU pipeline 慢，超时放宽到 900s
# mineru-api 启动不带 --enable-vlm-preload（无 vllm 可加载），见 scripts/mineru_api_cpu.sh
# ====================================================================

# ===== LLM（云 API，不占本地 GPU，甲方需联网 + 此 Key）=====
GLM_API_KEY=1fe057e6f3f54c4faf31f9ff10cea47f.NlzQu2GszGE8i2tz
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.2
GLM_TEMPERATURE=0.1
GLM_REQUIRED_AT_STARTUP=false

# ===== MySQL 8 =====
DATABASE_URL=mysql+pymysql://semantic_user:change_me@127.0.0.1:3306/semantic_toolkit?charset=utf8mb4
DATABASE_AUTO_CREATE=true
DATABASE_REQUIRED=true

DEFAULT_WORKSPACE_ID=default
MODEL_VERSION=semantic-toolkit-2026.08
CORS_ORIGINS=http://127.0.0.1:6006,http://localhost:6006,http://127.0.0.1:5173,http://localhost:5173
MAX_UPLOAD_SIZE_MB=50

# mineru CLI 降级备用路径（极速版主流程不走 CLI，仅留作极端降级；甲方按实际 conda 环境路径填）
MINERU_BIN=/root/autodl-tmp/conda/envs/mineru_cpu/bin/mineru

# ===== MinerU 常驻服务（CPU pipeline 后端，不依赖 vllm/GPU）=====
# mineru-api 常驻地址（supervisor 守护，pipeline 后端 onnxruntime CPU）
# 甲方需先建 mineru_cpu conda 环境：pip install "mineru[core,pipeline]"（不要 vllm extra）
MINERU_API_URL=http://127.0.0.1:8899
MINERU_BACKEND=pipeline
MINERU_API_TIMEOUT=900
# CPU 版并发调低：onnxruntime 单请求占满核，高并发争抢 CPU 不线性，3 为安全值（核多可调到 4）
MINERU_PAGE_BUDGET=60
MINERU_MAX_CONCURRENCY=3

# PDF 抽取极速模式：light=纯文本工具走 PyMuPDF(CPU) + 强结构工具(citation)走 mineru pipeline(CPU)
PDF_EXTRACT_MODE=light

# ===== bge 向量模型走 CPU（无 GPU 强制）=====
# 显式声明 CPU；代码本身也会 _gpu_available() 自适应，此处双保险
BGE_DEVICE=cpu
