# ================= GLM 大模型 =================
# 请填写真实密钥；不要把 config/.env 提交到版本库
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.2
GLM_TEMPERATURE=0.1
GLM_CONNECT_TIMEOUT_SECONDS=8
# false：未配置密钥时服务仍可启动并完成前端/数据库联调；调用依赖模型的功能时返回明确错误。
# 正式服务器建议设为 true，让部署在启动期就检查模型密钥。
GLM_REQUIRED_AT_STARTUP=false

# ================= 数据库（MySQL 8） =================
DATABASE_URL=mysql+pymysql://semantic_user:change_me@127.0.0.1:3306/semantic_toolkit?charset=utf8mb4
DATABASE_AUTO_CREATE=true
DATABASE_REQUIRED=true
ASYNC_WORKERS=4
# 逐篇工具批量执行的 GLM 并发数（默认6；遇429下调到3-4）
GLM_MAX_CONCURRENCY=6

# ================= 平台 =================
DEFAULT_WORKSPACE_ID=default
MODEL_VERSION=semantic-toolkit-2026.08
# 前端 6006（AutoDL 自定义服务默认端口）/ 本地开发 5173
CORS_ORIGINS=http://127.0.0.1:6006,http://localhost:6006,http://127.0.0.1:5173,http://localhost:5173
MAX_UPLOAD_SIZE_MB=50

# ================= 纯 CPU 运行 =================
# 强制 bge 编码器等全部使用 CPU（不占用 GPU）
BGE_DEVICE=cpu

# ================= MinerU PDF 解析（可选，扫描件/强结构工具用） =================
# mineru conda 环境的可执行文件路径
MINERU_BIN=/root/miniconda3/envs/mineru/bin/mineru
# mineru-api 常驻服务地址（mineru-api --host 127.0.0.1 --port 8899）
MINERU_API_URL=http://127.0.0.1:8899
# CPU 环境用 pipeline 后端；vlm-engine 需要 vllm+GPU
MINERU_BACKEND=pipeline
# CPU pipeline 解析慢，大文件超时给足
MINERU_API_TIMEOUT=1800
# mineru-api 3.x 服务端并发上限为 3，客户端对齐
MINERU_MAX_CONCURRENCY=3
MINERU_PAGE_BUDGET=60
# 页切片并行解析：纯 CPU 单请求已吃满核（实测并发分片反而更慢），默认关闭
MINERU_PARALLEL_SLICES=false

# ================= PDF 抽取双模式 =================
# full=所有 PDF 走 mineru（高质量慢）；light=多数工具走 PyMuPDF 毫秒级直抽，
# 扫描件/双栏/强结构工具（引用情感、引用意图）自动回退 mineru
PDF_EXTRACT_MODE=light
